{$SPOTWISE_DOMAIN} {
    request_body {
        max_size 32KB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
    @legacy_exports path /runs/*/export/*
    handle @legacy_exports {
        rewrite * /api/v1{uri}
        reverse_proxy 127.0.0.1:8000
    }
    @events path /runs/*/events
    handle @events {
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
        }
    }
    handle {
        encode zstd gzip
        reverse_proxy 127.0.0.1:8000
    }
}
