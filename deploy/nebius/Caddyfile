{$SPOTWISE_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 32KB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
    reverse_proxy 127.0.0.1:8000 {
        flush_interval -1
    }
}
