        ]
      },
      {
        "typename": "bplan:c_bp_ak",
        "expected_count_range": [40, 300],
        "allowed_statuses": ["repealed"],
        "expected_properties": [
          "gisid", "planid", "planname", "planartname", "verfahrensart", "bereich", "bezirk",
          "bp_rechtsstand", "afs_behoer", "afs_beschl", "afs_l_aend", "bbg_anfang", "bbg_ende",
          "aul_anfang", "aul_ende", "festsg_von", "festsg_am", "fsg_gvbl_n", "fsg_gvbl_s",
          "fsg_gvbl_d", "normkontr", "scan_www", "grund_www", "url_www", "inhalt", "ersetztteil",
          "ersetztvoll", "ersetztdurchteil", "ersetztdurchvoll"
