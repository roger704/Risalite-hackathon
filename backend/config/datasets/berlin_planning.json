    "expected_crs": "EPSG:25833",
    "source_bbox": [
      360000,
      5790000,
      420000,
      5850000
    ],
    "allowed_bbox": [
      13.0,
      52.3,
      13.9,
      52.8
    ],
    "id_field": "planid",
    "id_pattern": "^[0-9A-Za-z][0-9A-Za-z/_-]*$",
    "layers": [
      {
        "typename": "bplan:a_bp_iv",
        "expected_count_range": [900, 1600],
        "allowed_statuses": ["in_progress"],
        "expected_properties": [
          "gisid", "planid", "planname", "planartname", "verfahrensart", "bereich", "bezirk",
          "bp_rechtsstand", "afs_behoer", "afs_beschl", "afs_l_aend", "bbg_anfang", "bbg_ende",
          "aul_anfang", "aul_ende", "ausleg_www", "inhalt", "ersetztteil", "ersetztvoll",
          "ersetztdurchteil", "ersetztdurchvoll"
        ]
      },
      {
        "typename": "bplan:b_bp_fs",
        "expected_count_range": [2400, 3400],
        "allowed_statuses": ["adopted", "partially_in_force"],
        "expected_properties": [
          "gisid", "planid", "planname", "planartname", "verfahrensart", "bereich", "bezirk",
          "bp_rechtsstand", "afs_behoer", "afs_beschl", "afs_l_aend", "bbg_anfang", "bbg_ende",
          "aul_anfang", "aul_ende", "festsg_von", "festsg_am", "fsg_gvbl_n", "fsg_gvbl_s",
